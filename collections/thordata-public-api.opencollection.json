        "name": "Proxy",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List purchased proxies",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://openapi.thordata.com/api/proxy/proxy-list",
            "params": [
              {
                "name": "token",
                "value": "",
                "type": "query",
                "description": "Public token. May also be sent as the token header."
              },
              {
                "name": "key",
                "value": "",
                "type": "query",
                "description": "Public key. May also be sent as the key header."
              },
              {
                "name": "proxy_type",
                "value": "",
                "type": "query",
                "description": "1=ISP, 2=Datacenter"
              }
            ]
          },
          "docs": "Returns ip, port, username, password and expiration_time per proxy. proxy_type 1=ISP, 2=Datacenter."
        },
        {
          "info": {
            "name": "Expiration time for specific proxy IPs",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://openapi.thordata.com/api/proxy/expiration-time",
            "params": [
              {
                "name": "token",
                "value": "",
                "type": "query",
                "description": "Public token. May also be sent as the token header."
              },
              {
                "name": "key",
                "value": "",
                "type": "query",
                "description": "Public key. May also be sent as the key header."
              },
              {
                "name": "proxy_type",
                "value": "",
                "type": "query",
                "description": "Proxy product type"
              },
              {
                "name": "ips",
                "value": "",
                "type": "query",
                "description": "Proxy IPs to query"
              }
            ]
          },
          "docs": "Expiration time for specific proxy IPs"
        }
      ]
    },
