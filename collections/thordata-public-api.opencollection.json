{
  "opencollection": "1.0.0",
  "info": {
    "name": "Thordata Public API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Account",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Daily traffic usage statistics",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://openapi.thordata.com/api/account/usage-statistics",
            "params": [
              {
                "name": "token",
                "value": "",
                "type": "query",
                "description": "Public token. May also be sent as the token header."
              },
              {
                "name": "key",
                "value": "",
                "type": "query",
                "description": "Public key. May also be sent as the key header."
              },
              {
                "name": "from_date",
                "value": "",
                "type": "query",
                "description": "Start date of the range"
              },
              {
                "name": "to_date",
                "value": "",
                "type": "query",
                "description": "End date of the range"
              }
            ]
          },
          "docs": "Returns query_days, range_usage_traffic (KB), total_usage_traffic (KB), traffic_balance (KB) and a daily usage breakdown. The query range cannot exceed 180 days (public API code 10021)."
        },
        {
          "info": {
            "name": "Remaining traffic balance",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://openapi.thordata.com/api/account/traffic-balance",
            "params": [
              {
                "name": "token",
                "value": "",
                "type": "query",
                "description": "Public token. May also be sent as the token header."
              },
              {
                "name": "key",
                "value": "",
                "type": "query",
                "description": "Public key. May also be sent as the key header."
              }
            ]
          },
          "docs": "Returns traffic_balance as a number in KB."
        },
        {
          "info": {
            "name": "Wallet balance",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://openapi.thordata.com/api/account/wallet-balance",
            "params": [
              {
                "name": "token",
                "value": "",
                "type": "query",
                "description": "Public token. May also be sent as the token header."
              },
              {
                "name": "key",
                "value": "",
                "type": "query",
                "description": "Public key. May also be sent as the key header."
              }
            ]
          },
          "docs": "Returns balance as a number in USD."
        }
      ]
    },
    {
