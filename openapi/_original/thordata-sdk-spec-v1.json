  "sdkScopes": {
    "languages": {
      "go": {
        "notes": [
          "Best for gateway services and high concurrency; keep APIs minimal and robust."
        ],
        "p0": [
          "proxyNetwork",
          "publicApi",
          "locations",
          "unlimited",
          "extract"
        ],
        "p1": [
          "serp",
          "webunlocker",
          "webScraperTasksLifecycle"
        ],
        "role": "Infrastructure / high-performance networking"
      },
      "java": {
        "notes": [
          "Focus on account management and task orchestration.",
          "Do not prioritize complex TLS-in-TLS proxy chaining; provide basic proxy URL builders only if requested."
        ],
        "p0": [
          "publicApi",
          "locations",
          "webScraperTasksLifecycle"
        ],
        "p1": [
          "serp",
          "webunlocker"
        ],
        "p2": [
          "proxyNetworkBasic",
          "browserConnection"
        ],
        "role": "Enterprise integration / management"
      },
      "node": {
        "notes": [
          "Prefer agent-based proxy handling; document limitations for TLS-in-TLS.",
          "Browser users usually rely on Playwright/Puppeteer; SDK should provide connection URL helpers."
        ],
        "p0": [
          "serp",
          "webunlocker",
          "webScraperTasks",
          "publicApi",
          "locations"
        ],
        "p1": [
          "browserConnection",
          "proxyNetwork",
          "unlimited"
        ],
        "role": "Product integration / service SDK"
      },
      "python": {
        "notes": [
          "Primary SDK for scraping/AI pipelines; must cover all products."
        ],
        "p0": [
          "serp",
          "webunlocker",
          "webScraperTasks",
          "proxyNetwork",
          "publicApi",
          "locations",
          "unlimited",
          "extract",
          "browserConnection"
        ],
        "p1": [
          "advancedRetry",
          "highConcurrencyAsync"
        ],
        "role": "Flagship / full coverage"
      }
    },
    "principles": [
      "Spec is canonical; language SDKs may implement a subset based on ecosystem needs.",
      "Python SDK is the reference implementation for behavioral details.",
      "All SDKs should implement consistent auth, error precedence, and base URL env handling."
    ]
  },
