  "universal": {
    "endpoint": {
      "auth": {
        "headers": {
          "AuthorizationBearer": "scraperToken"
        },
        "mode": "bearer"
      },
      "baseUrlRef": "webunlocker",
      "method": "POST",
      "path": "/request"
    },
    "request": {
      "contentType": "application/x-www-form-urlencoded",
      "fields": {
        "block_resources": {
          "description": "Comma-separated resource types to block (e.g., image,script,css)",
          "required": false,
          "type": "string"
        },
        "clean_content": {
          "description": "Comma-separated content types to remove (e.g., js,css)",
          "required": false,
          "type": "string"
        },
        "cookies": {
          "description": "JSON string of cookies list (SDK serializes list[dict] via json.dumps)",
          "example": "[{\"name\":\"session\",\"value\":\"abc\"}]",
          "required": false,
          "type": "string"
        },
        "country": {
          "description": "Proxy country code (e.g., us, de)",
          "required": false,
          "type": "string"
        },
        "headers": {
          "description": "JSON string of headers list (SDK serializes list[dict] via json.dumps)",
          "example": "[{\"name\":\"User-Agent\",\"value\":\"Mozilla/5.0\"}]",
          "required": false,
          "type": "string"
        },
        "js_render": {
          "default": "False",
          "description": "Enable JavaScript rendering",
          "enum": [
            "True",
            "False"
          ],
          "type": "string"
        },
        "type": {
          "default": "html",
          "description": "Output format",
          "enum": [
            "html",
            "png"
          ],
          "type": "string"
        },
        "url": {
          "description": "Target URL to scrape",
          "required": true,
          "type": "string"
        },
        "wait": {
          "description": "Wait time in milliseconds (0-100000)",
          "required": false,
          "type": "string"
        },
        "wait_for": {
          "description": "CSS selector to wait for",
          "required": false,
          "type": "string"
        }
      }
    },
    "response": {
      "output": {
        "html": {
          "contentType": "text/html",
          "type": "string"
        },
        "png": {
          "contentType": "image/png",
          "type": "bytes"
        }
      },
      "successCodes": [
        200
      ]
    },
    "userAgent": {
      "components": {
